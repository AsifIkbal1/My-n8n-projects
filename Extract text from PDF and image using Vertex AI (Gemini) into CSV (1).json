    },
    {
      "parameters": {
        "jsCode": "// n8n Function Node – Add a new field 'myNewField' to each input item\n\n// Loop through all input items\nconst newItems = $input.all().map(item => {\n  return {\n    json: {\n      ...item.json,      // Copy existing JSON fields\n      myNewField: 1      // Add new field\n    }\n  };\n});\n\nreturn newItems;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1248,
        608
      ],
      "id": "8158d8a2-a00e-428f-8c0b-5ad347e8153d",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.text }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a highly intelligent AI assistant specialized in reading and summarizing PDF documents. \nYour task is to carefully read the content provided from the PDF and generate a concise, clear, and structured summary. \nFollow these rules:\n\n1. Only summarize the content; do not add unrelated information or opinions.\n2. Break the summary into sections or bullet points if applicable.\n3. Highlight key concepts, important facts, and main ideas.\n4. Keep the summary short, precise, and easy to understand.\n5. If the PDF contains code, tables, or structured data, include them in a readable format in the summary.\n6. Do not output anything besides the summary in the response.\n\nOutput Format:\n- Use headings or bullet points where needed.\n- Keep paragraphs short and clear.\n- Maintain the logical order of the content.\n\nThe user will provide the PDF text content as input. Always produce the summary based on that content."
        }
      },
