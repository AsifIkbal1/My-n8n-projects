      "id": "2fdca01d-f93c-4b15-ba03-cb69840a87b1",
      "name": "Ignore large PDFs",
      "type": "n8n-nodes-base.noOp",
      "position": [
        2064,
        320
      ],
      "typeVersion": 1
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "=let results = [];\n\nfor (const item of $input.all()) {\n  if (!item.binary) continue;\n\n  for (const key of Object.keys(item.binary)) {\n\n    const file = item.binary[key];\n    const mime = file.mimeType || \"\";\n    const name = file.fileName || \"\";\n\n    let fileType = \"other\";\n\n    // Detect Image\n    if (mime.startsWith(\"image/\")) {\n      fileType = \"image\";\n    }\n\n    // Detect Word Docs\n    else if (\n      mime.includes(\"word\") ||\n      name.endsWith(\".doc\") ||\n      name.endsWith(\".docx\") ||\n      name.endsWith(\".rtf\") ||\n      name.endsWith(\".txt\")\n    ) {\n      fileType = \"docs\";\n    }\n\n    // Detect Excel / Sheets\n    else if (\n      mime.includes(\"sheet\") ||\n      name.endsWith(\".xls\") ||\n      name.endsWith(\".xlsx\") ||\n      name.endsWith(\".ods\")\n    ) {\n      fileType = \"sheet\";\n    }\n\n    // Detect CSV\n    else if (\n      mime === \"text/csv\" ||\n      name.endsWith(\".csv\")\n    ) {\n      fileType = \"csv\";\n    }\n\n    results.push({\n      json: {\n        fileName: name,\n        mimeType: mime,\n        fileType: fileType\n      },\n      binary: {\n        data: file\n      }\n    });\n  }\n}\n\nreturn results;\n",
              "value2": true
            }
          ]
        }
      },
